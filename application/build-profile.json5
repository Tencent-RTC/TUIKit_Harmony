{
  "app": {
    "signingConfigs": [],
    "products": [
      {
        "name": "default",
        "targetSdkVersion": "6.0.0(20)",
        "compatibleSdkVersion": "6.0.0(20)",
        "runtimeOS": "HarmonyOS",
        "buildOption": {
          "strictMode": {
            "caseSensitiveCheck": true,
            "useNormalizedOHMUrl": true
          }
        }
      }
    ],
    "buildModeSet": [
      {
        "name": "debug"
      },
      {
        "name": "release"
      }
    ]
  },
  "modules": [
    {
      "name": "entry",
      "srcPath": "./entry",
      "targets": [
        {
          "name": "default",
          "applyToProducts": [
            "default"
          ]
        }
      ]
    },
    {
      "name": "tuilivekit",
      "srcPath": "../live/TUILiveKit"
    },
    {
      "name": "tuiroomkit",
      "srcPath": "../room/TUIRoomKit"
    },
    {
      "name": "chatuikit",
      "srcPath": "../chat/uikit"
    },
    {
      "name": "atomic_x",
      "srcPath": "../atomic_x"
    }
  ]
}
